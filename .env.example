# Local development needs no frontend env vars.
# The frontend calls /api, which Vite proxies to the local backend (see vite.config.js).

# Only required for deployed builds (e.g. Vercel), where no dev proxy exists.
# Set this to the public base URL of the hosted Vela API, including /api.
# Example: VITE_API_BASE_URL=https://vela-api.example.com/api
# VITE_API_BASE_URL=
