{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "myProjDB": "Server=localhost;Database=VelaDb;Trusted_Connection=True;MultipleActiveResultSets=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "Vela.Api",
    "Audience": "Vela.Client",
    "Key": "replace-with-your-32-plus-char-jwt-secret",
    "ExpiresMinutes": 480
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "MapTiler": {
    "BaseUrl": "https://api.maptiler.com",
    "ApiKey": "replace-with-your-maptiler-key"
  },
  "Nasa": {
    "DonkiBaseUrl": "https://api.nasa.gov/DONKI",
    "ApiKey": "DEMO_KEY"
  },
  "VisiblePlanets": {
    "BaseUrl": "https://api.visibleplanets.dev/v3"
  },
  "Nominatim": {
    "BaseUrl": "https://nominatim.openstreetmap.org",
    "UserAgent": "Vela.Api/1.0"
  },
  "WorldAtlas": {
    "Path": "data/World_Atlas_2015.tif",
    "LandMaskPath": "Data/land-10m.geojson"
  }
}
